# Which image model powers the portrait restyle.
# openai | gemini | none   (none = era filter only, no AI call)
PORTRAIT_PROVIDER=none

# OpenAI (gpt-image-1 image edits)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# Google Gemini (image preview / "nano banana" style edits)
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

PORT=3000

# Max upload size for a selfie, in megabytes.
MAX_UPLOAD_MB=8
